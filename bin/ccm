#!/usr/bin/env python3
"""ccm — Claude Code session manager.

  ccm            open (or re-attach to) the manager
  ccm --picker   run the picker only (used inside the ccm tmux server)

Picker keys: type to filter · ↑/↓ PgUp/PgDn · Enter or click = open/focus ·
Ctrl-N = new session (asks for a folder; Tab completes) · Ctrl-R = rescan · Esc = clear filter / detach
F5 = toggle sessions sidebar in a grid window
  ccm --notify   Claude Code Stop/Notification hook: flag pane + Windows toast
tmux keys:  F1 sessions list · F2 zoom pane · F3 next grid · click pane to focus
"""
import curses, json, locale, os, random, shlex, subprocess, sys, time
from pathlib import Path

HOME = Path.home()
PROJECTS = HOME / ".claude" / "projects"
CACHE = HOME / ".cache" / "ccm" / "index.json"
CONF = HOME / ".config" / "ccm" / "tmux.conf"
SOCKET = os.environ.get("CCM_SOCKET", "ccm")
PER_WINDOW = int(os.environ.get("CCM_PER_WINDOW", "4"))
HEAD, TAIL = 256 * 1024, 256 * 1024


# ---------------------------------------------------------------- session index
def _parse(path: Path) -> dict:
    size = path.stat().st_size
    cwd = branch = prompt = None
    with path.open("rb") as f:
        for raw in f.read(HEAD).splitlines():
            try:
                d = json.loads(raw)
            except Exception:
                continue
            cwd = cwd or d.get("cwd")
            branch = branch or d.get("gitBranch")
            if prompt is None and d.get("type") == "user" and not d.get("isMeta") and not d.get("isSidechain"):
                c = d.get("message", {}).get("content")
                if isinstance(c, list):
                    c = " ".join(x.get("text", "") for x in c if isinstance(x, dict) and x.get("type") == "text")
                if isinstance(c, str) and c.strip() and not c.lstrip().startswith("<"):
                    prompt = " ".join(c.split())
            if cwd and prompt:
                break
        f.seek(max(0, size - TAIL))
        custom = ai = None
        for raw in reversed(f.read().splitlines()):
            if b"-title" not in raw:
                continue
            try:
                d = json.loads(raw)
            except Exception:
                continue
            if d.get("type") == "custom-title" and not custom:
                custom = d.get("customTitle")
            elif d.get("type") == "ai-title" and not ai:
                ai = d.get("aiTitle")
            if custom:
                break
    return {"cwd": cwd, "branch": branch, "title": custom or ai or prompt}


def load_sessions() -> list:
    try:
        cache = json.loads(CACHE.read_text())
    except Exception:
        cache = {}
    out, fresh = [], {}
    for p in PROJECTS.glob("*/*.jsonl"):
        try:
            st = p.stat()
        except FileNotFoundError:
            continue
        key, sig = str(p), [st.st_mtime, st.st_size]
        hit = cache.get(key)
        meta = hit["meta"] if hit and hit["sig"] == sig else _parse(p)
        fresh[key] = {"sig": sig, "meta": meta}
        if meta.get("title"):
            out.append({"sid": p.stem, "mtime": st.st_mtime, **meta})
    CACHE.parent.mkdir(parents=True, exist_ok=True)
    CACHE.write_text(json.dumps(fresh))
    out.sort(key=lambda s: s["mtime"], reverse=True)
    return out


# ---------------------------------------------------------------- tmux helpers
def tmux(*args) -> str:
    return subprocess.run(["tmux", *args], capture_output=True, text=True).stdout.strip()


def open_panes() -> dict:
    """session-id -> (window_id, pane_id, state) for panes this manager opened."""
    res = {}
    for line in tmux("list-panes", "-s", "-F", "#{window_id} #{pane_id} #{@ccm_sid} #{@ccm_state}").splitlines():
        parts = line.split()
        if len(parts) >= 3:
            res[parts[2]] = (parts[0], parts[1], parts[3] if len(parts) > 3 else "")
    return res


POWERSHELL = "/mnt/c/Windows/System32/WindowsPowerShell/v1.0/powershell.exe"


def win_sound(kind: str) -> str:
    """Copy the chime for `kind` (done/input) somewhere Windows can read it; return its Windows path."""
    src = HOME / ".config" / "ccm" / f"{kind}.wav"  # your own sound wins
    if not src.exists():
        src = Path(os.path.realpath(__file__)).parent.parent / "sounds" / f"{kind}.wav"
    if not src.exists():
        return ""
    cache = CACHE.parent / "localappdata"
    try:
        lad = cache.read_text().strip()
    except Exception:
        lad = subprocess.run(["cmd.exe", "/c", "echo %LOCALAPPDATA%"], capture_output=True, text=True,
                             cwd="/mnt/c").stdout.strip()
        cache.write_text(lad)
    dst = Path(subprocess.run(["wslpath", "-u", lad], capture_output=True, text=True).stdout.strip()) / "ccm" / src.name
    if not dst.exists() or dst.stat().st_size != src.stat().st_size or dst.stat().st_mtime < src.stat().st_mtime:
        dst.parent.mkdir(parents=True, exist_ok=True)
        dst.write_bytes(src.read_bytes())
    return f"{lad}\\ccm\\{src.name}"


def log(msg: str):
    try:
        with (CACHE.parent / "notify.log").open("a") as f:
            f.write(f"{time.strftime('%F %T')} {msg}\n")
    except Exception:
        pass


def toast(title: str, body: str, kind: str = "done"):
    """Windows toast from WSL with ccm's own soft chime instead of the system sound (no-op elsewhere)."""
    if not os.path.exists(POWERSHELL):
        return
    try:
        wav = win_sound(kind)
    except Exception as e:
        wav = ""
        log(f"sound lookup failed: {e!r}")
    q = lambda t: t.replace("'", "''")[:200]
    ps = (
        ""  # start the chime first (async): its silent lead-in wakes Bluetooth audio while the toast is built
        + (f"$s=New-Object Media.SoundPlayer '{q(wav)}';$s.Load();$s.Play();" if wav else "")
        + "[Windows.UI.Notifications.ToastNotificationManager,Windows.UI.Notifications,ContentType=WindowsRuntime]>$null;"
        "$t=[Windows.UI.Notifications.ToastNotificationManager]::GetTemplateContent([Windows.UI.Notifications.ToastTemplateType]::ToastText02);"
        "$x=$t.GetElementsByTagName('text');"
        f"$x.Item(0).AppendChild($t.CreateTextNode('{q(title)}'))>$null;"
        f"$x.Item(1).AppendChild($t.CreateTextNode('{q(body)}'))>$null;"
        + ("$a=$t.CreateElement('audio');$a.SetAttribute('silent','true');$t.DocumentElement.AppendChild($a)>$null;" if wav else "")
        + "[Windows.UI.Notifications.ToastNotificationManager]::CreateToastNotifier("
        "'{1AC14E77-02E7-4E5D-B744-2EB1AE5198B7}\\WindowsPowerShell\\v1.0\\powershell.exe')"
        ".Show([Windows.UI.Notifications.ToastNotification]::new($t));"
        + ("Start-Sleep -Milliseconds 3500;'played '+(Get-Date -f HH:mm:ss)" if wav else "")  # keep alive until the chime ends
    )
    argv = [POWERSHELL, "-NoProfile", "-NonInteractive", "-Command", ps]
    if os.environ.get("TMUX"):
        # Run it from the tmux server: a hook's own child processes get killed when the hook exits,
        # which cut the chime off mid-play.
        r = subprocess.run(["tmux", "run-shell", "-b", " ".join(shlex.quote(a) for a in argv) + f" >>{shlex.quote(str(CACHE.parent / 'ps.log'))} 2>&1"],
                           capture_output=True, text=True)
        if r.returncode:
            log(f"tmux run-shell failed rc={r.returncode}: {r.stderr.strip()[:200]}")
    else:
        subprocess.Popen(argv, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                         stderr=subprocess.DEVNULL, start_new_session=True)


def notify():
    """Claude Code hook (Stop / Notification): flag the pane and toast if you're not looking at it."""
    try:
        data = json.load(sys.stdin)
    except Exception:
        data = {}
    pane = os.environ.get("TMUX_PANE")
    if not pane or f"/{SOCKET}," not in os.environ.get("TMUX", ""):
        return  # not running inside ccm
    event = data.get("hook_event_name", "Stop")
    if event == "Notification" and data.get("notification_type") == "idle_prompt":
        return  # the "still waiting" reminder after a finished turn: already flagged
    state = "input" if event == "Notification" else "done"
    # Always toast + chime: tmux can't tell whether Windows Terminal is actually the window you're looking at.
    # Only skip the badge on the pane that already has focus (it would be cleared on focus anyway).
    visible = tmux("display", "-p", "-t", pane, "#{&&:#{pane_active},#{&&:#{window_active},#{session_attached}}}")
    if visible != "1":
        tmux("set", "-p", "-t", pane, "@ccm_state", state)
    log(f"{event} {pane} {state}")
    title = tmux("display", "-p", "-t", pane, "#{@ccm_title}") or "Claude"
    msg = data.get("message") or ("Needs your input" if state == "input" else "Finished")
    tmux("display-message", "-d", "4000", f"{'⏳' if state == 'input' else '✔'} {title}: {msg}")
    toast(f"Claude · {title}", msg, state)


# (bright = focused, dim = unfocused) per pane
PALETTE = [("colour39", "colour24"), ("colour170", "colour96"), ("colour114", "colour65"), ("colour214", "colour130"),
           ("colour141", "colour60"), ("colour80", "colour30"), ("colour203", "colour131"), ("colour221", "colour137")]


def colorize(pane: str, win: str):
    used = set(tmux("list-panes", "-t", win, "-F", "#{@ccm_color}").split())
    bright, dim = random.choice([c for c in PALETTE if c[0] not in used] or PALETTE)
    tmux("set", "-p", "-t", pane, "@ccm_color", bright)
    tmux("set", "-p", "-t", pane, "@ccm_dim", dim)
SIDEBAR_W = int(os.environ.get("CCM_SIDEBAR_WIDTH", "44"))
ME = f"{shlex.quote(sys.executable)} {shlex.quote(os.path.abspath(__file__))}"


def grid_counts() -> dict:
    """window_id -> [window_index, session panes (sidebar excluded), has_sidebar]."""
    res = {}
    for line in tmux("list-panes", "-s", "-F", "#{window_id} #{window_index} #{?@ccm_sidebar,1,0}").splitlines():
        wid, idx, side = line.split()
        r = res.setdefault(wid, [idx, 0, False])
        if side == "1":
            r[2] = True
        else:
            r[1] += 1
    return res


def _split(total: int, k: int) -> list:
    usable = total - (k - 1)  # 1-cell border between neighbours
    return [usable // k + (1 if i < usable % k else 0) for i in range(k)]


def _checksum(s: str) -> str:
    c = 0
    for ch in s:
        c = ((c >> 1) + ((c & 1) << 15) + ord(ch)) & 0xFFFF
    return f"{c:04x}"


def retile(win: str):
    """Tile session panes; if a sidebar is present keep it as a fixed column on the left."""
    panes = [l.split() for l in tmux("list-panes", "-t", win, "-F", "#{pane_id} #{?@ccm_sidebar,1,0}").splitlines()]
    for line in tmux("list-panes", "-t", win, "-F", "#{?@ccm_dim,,#{pane_id} #{?@ccm_sidebar,1,0}}").splitlines():
        if line.strip():  # backfill panes opened before colours existed
            pid, sb = line.split()
            if sb == "1":
                tmux("set", "-p", "-t", pid, "@ccm_color", "colour250")
                tmux("set", "-p", "-t", pid, "@ccm_dim", "colour240")
            else:
                colorize(pid, win)
    side = [p for p, f in panes if f == "1"]
    rest = [p for p, f in panes if f == "0"]
    if not side:
        tmux("select-layout", "-t", win, "tiled")
        return
    if not rest:
        return
    W, H = map(int, tmux("display", "-p", "-t", win, "#{window_width} #{window_height}").split())
    sw = min(SIDEBAR_W, W // 2)
    gx, gw = sw + 1, W - sw - 1
    n = len(rest)
    cols = 1
    while cols * cols < n:
        cols += 1
    nrows = -(-n // cols)
    rows, y, it = [], 0, iter(rest)
    for r, rh in enumerate(_split(H, nrows)):
        k = min(cols, n - r * cols)
        cells, x = [], gx
        for cw in _split(gw, k):
            cells.append(f"{cw}x{rh},{x},{y},{next(it)[1:]}")
            x += cw + 1
        rows.append(cells[0] if k == 1 else f"{gw}x{rh},{gx},{y}{{{','.join(cells)}}}")
        y += rh + 1
    grid = rows[0] if nrows == 1 else f"{gw}x{H},{gx},0[{','.join(rows)}]"
    body = f"{W}x{H},0,0{{{sw}x{H},0,0,{side[0][1:]},{grid}}}"
    tmux("select-layout", "-t", win, f"{_checksum(body)},{body}")


def toggle_sidebar(win: str):
    for pid, f in (l.split() for l in tmux("list-panes", "-t", win, "-F", "#{pane_id} #{?@ccm_sidebar,1,0}").splitlines()):
        if f == "1":
            tmux("kill-pane", "-t", pid)
            retile(win)
            return
    if tmux("display", "-p", "-t", win, "#{window_index}") == "0":
        return  # the full sessions list is already here
    pane = tmux("split-window", "-hbf", "-t", win, "-l", str(SIDEBAR_W), "-P", "-F", "#{pane_id}",
                f"{ME} --picker --sidebar")
    tmux("set", "-p", "-t", pane, "@ccm_sidebar", "1")
    tmux("set", "-p", "-t", pane, "@ccm_title", "sessions")
    tmux("set", "-p", "-t", pane, "@ccm_color", "colour250")
    tmux("set", "-p", "-t", pane, "@ccm_dim", "colour240")
    retile(win)
    tmux("select-pane", "-t", pane)


def launch(cmd: str, cwd: str, sid: str, title: str):
    target, counts = None, grid_counts()
    here = tmux("display", "-p", "-t", os.environ.get("TMUX_PANE", ""), "#{window_id}")
    if here in counts and counts[here][2] and counts[here][1] < PER_WINDOW:
        target = here  # opened from a sidebar: fill this window first
    else:
        for wid, (idx, n, _) in counts.items():
            if idx != "0" and n < PER_WINDOW:
                target = wid
                break
    if target:
        pane = tmux("split-window", "-d", "-t", target, "-c", cwd, "-P", "-F", "#{pane_id}", cmd)
    else:
        pane = tmux("new-window", "-d", "-n", "grid", "-c", cwd, "-P", "-F", "#{pane_id}", cmd)
        target = tmux("display", "-p", "-t", pane, "#{window_id}")
    if not pane:
        return
    tmux("set", "-p", "-t", pane, "@ccm_sid", sid)
    tmux("set", "-p", "-t", pane, "@ccm_title", title[:60])
    colorize(pane, target)
    retile(target)
    tmux("select-window", "-t", target)
    tmux("select-pane", "-t", pane)


def new_session(cwd: str):
    launch("exec claude", cwd, "", f"new · {'~' if cwd == str(HOME) else Path(cwd).name}")


def open_session(s: dict):
    cwd = s["cwd"] if s.get("cwd") and os.path.isdir(s["cwd"]) else str(HOME)
    live = open_panes().get(s["sid"])
    if live:
        tmux("select-window", "-t", live[0])
        tmux("select-pane", "-t", live[1])
        return
    launch(f"exec claude --resume {shlex.quote(s['sid'])}", cwd, s["sid"], s["title"])


# ---------------------------------------------------------------- picker UI
def age(ts: float) -> str:
    d = time.time() - ts
    for unit, sec in (("w", 604800), ("d", 86400), ("h", 3600), ("m", 60)):
        if d >= sec:
            return f"{int(d // sec)}{unit}"
    return "now"


def project(s: dict) -> str:
    cwd = s.get("cwd") or "?"
    return "~" if cwd == str(HOME) else Path(cwd).name


def _tilde(path: str) -> str:
    return "~" + path[len(str(HOME)):] if path == str(HOME) or path.startswith(str(HOME) + "/") else path


def complete_dir(text: str) -> tuple:
    """Tab-complete a directory path. Returns (new_text, candidate names)."""
    full = os.path.expanduser(text)
    parent, stem = os.path.split(full)
    try:
        names = sorted(n for n in os.listdir(parent or "/")
                       if n.startswith(stem) and os.path.isdir(os.path.join(parent or "/", n))
                       and (stem.startswith(".") or not n.startswith(".")))
    except OSError:
        return text, []
    if not names:
        return text, []
    common = os.path.commonprefix(names)
    done = os.path.join(parent, common) + ("/" if len(names) == 1 else "")
    return _tilde(done), names


def dir_suggestions(text: str, limit: int = 8) -> list:
    """Folders matching what's typed after the last '/': prefix matches first, then substring (case-insensitive)."""
    full = os.path.expanduser(text)
    parent, stem = os.path.split(full)
    parent = parent or "/"
    try:
        names = [n for n in os.listdir(parent) if os.path.isdir(os.path.join(parent, n))
                 and (stem.startswith(".") or not n.startswith("."))]
    except OSError:
        return []
    low = stem.lower()
    pre = sorted(n for n in names if n.lower().startswith(low))
    sub = sorted(n for n in names if low and low in n.lower() and n not in pre)
    return [_tilde(os.path.join(parent, n)) + "/" for n in (pre + sub)[:limit]]


def ask_dir(scr, initial: str):
    """Bottom prompt for the new session's folder with live folder suggestions. Returns a path or None."""
    text = _tilde(initial).rstrip("/") + "/"
    pick, note = 0, ""
    curses.curs_set(1)
    try:
        while True:
            h, w = scr.getmaxyx()
            sugg = dir_suggestions(text, max(1, min(8, h - 6)))
            pick = max(0, min(pick, len(sugg) - 1))
            label = " New session in: "
            top_y = h - 2 - len(sugg)
            for n, cand in enumerate(sugg):  # suggestion list just above the prompt
                y = top_y + n
                scr.move(y, 0); scr.clrtoeol()
                attr = curses.A_REVERSE if n == pick else curses.color_pair(3)
                scr.addnstr(y, 0, ("  ▸ " if n == pick else "    ") + cand[-(w - 6):], w - 1, attr)
            scr.move(h - 2, 0); scr.clrtoeol()
            scr.addnstr(h - 2, 0, label, w - 1, curses.A_BOLD | curses.color_pair(2))
            shown = text[-(w - len(label) - 2):]
            scr.addnstr(h - 2, len(label), shown, max(0, w - len(label) - 1))
            scr.move(h - 1, 0); scr.clrtoeol()
            scr.addnstr(h - 1, 0, " " + (note or "↑↓ pick · Tab accept · Enter start · Esc cancel"), w - 1,
                        curses.color_pair(3))
            scr.move(h - 2, min(w - 2, len(label) + len(shown)))
            scr.refresh()
            try:
                k = scr.get_wch()
            except curses.error:
                continue
            note = ""
            if k == "\x1b":
                return None
            if k in ("\n", "\r", curses.KEY_ENTER):
                path = os.path.abspath(os.path.expanduser(text.strip() or "~"))
                if not os.path.isdir(path) and sugg:
                    path = os.path.abspath(os.path.expanduser(sugg[pick]))
                if os.path.isdir(path):
                    return path
                note = f"not a folder: {_tilde(path)}"
            elif k in ("\t", curses.KEY_RIGHT) and sugg:
                text, pick = sugg[pick], 0
            elif k == curses.KEY_DOWN:
                pick += 1
            elif k == curses.KEY_UP:
                pick -= 1
            elif k in (curses.KEY_BACKSPACE, "\x7f", "\b"):
                text, pick = text[:-1], 0
            elif k == "\x15":  # Ctrl-U
                text, pick = "", 0
            elif k == "\x17":  # Ctrl-W: drop last path segment
                text = text.rstrip("/").rsplit("/", 1)[0] + "/" if "/" in text.rstrip("/") else ""
                pick = 0
            elif k == curses.KEY_MOUSE:
                try:
                    _, _, my, _, b = curses.getmouse()
                except curses.error:
                    continue
                if b & (curses.BUTTON1_PRESSED | curses.BUTTON1_CLICKED) and top_y <= my < top_y + len(sugg):
                    text, pick = sugg[my - top_y], 0
            elif isinstance(k, str) and k.isprintable():
                text, pick = text + k, 0
            scr.erase()  # suggestion count changes; redraw cleanly next loop
    finally:
        curses.curs_set(0)


def details(scr, s: dict, y0: int, w: int, lines: int):
    """'Tooltip' box: full title of the highlighted/hovered session, then folder · branch · age."""
    import textwrap
    scr.addnstr(y0, 0, "─" * (w - 1), w - 1, curses.color_pair(3))
    wrapped = textwrap.wrap(s["title"], max(10, w - 3))[:lines - 2] or [""]
    for n, part in enumerate(wrapped):
        scr.addnstr(y0 + 1 + n, 1, part, w - 2, curses.A_BOLD)
    meta = f"{_tilde(s.get('cwd') or '?')}" + (f" · {s['branch']}" if s.get("branch") and s["branch"] != "HEAD" else "") \
        + (" · just now" if age(s["mtime"]) == "now" else f" · {age(s['mtime'])} ago")
    scr.addnstr(y0 + 1 + len(wrapped), 1, meta, w - 2, curses.color_pair(2))


def picker(scr, sidebar=False):
    curses.curs_set(0)
    curses.use_default_colors()
    for i, c in enumerate((curses.COLOR_GREEN, 214 if curses.COLORS > 214 else curses.COLOR_YELLOW, 244 if curses.COLORS > 244 else curses.COLOR_WHITE), 1):
        curses.init_pair(i, c, -1)
    curses.mousemask(curses.ALL_MOUSE_EVENTS | curses.REPORT_MOUSE_POSITION)
    curses.mouseinterval(0)
    WHEEL_DOWN = getattr(curses, "BUTTON5_PRESSED", 0x200000)
    scr.timeout(3000)

    scr.addstr(0, 1, "scanning sessions…")
    scr.refresh()
    sessions, query, sel, top, hover = load_sessions(), "", 0, 0, None
    sys.stdout.write("\033[?1003h"); sys.stdout.flush()  # ask for mouse-motion events (hover)
    live, last_scan = open_panes(), time.time()

    while True:
        q = query.lower().split()
        rows = [s for s in sessions
                if all(w in f"{s['title']} {project(s)} {s.get('branch') or ''}".lower() for w in q)]
        h, w = scr.getmaxyx()
        DET = 5 if h >= 16 else 0  # detail box: separator + up to 3 title lines + meta line
        body = max(1, h - 3 - DET)
        sel = max(0, min(sel, len(rows) - 1))
        top = min(max(top, sel - body + 1), sel) if rows else 0

        scr.erase()
        scr.addnstr(0, 0, f" Claude sessions ({len(rows)}/{len(sessions)})   filter: {query}▏", w - 1, curses.A_BOLD)
        for i, s in enumerate(rows[top:top + body]):
            y, idx = i + 1, top + i
            st = live[s["sid"]][2] if s["sid"] in live else None
            mark = {"done": "✔", "input": "⏳"}.get(st, "●") if st is not None else " "
            pw = 10 if sidebar else 18
            proj = project(s)[:pw].ljust(pw)
            line = f" {mark} {age(s['mtime']):>4}  {proj}  {s['title']}"
            attr = curses.A_REVERSE if idx == sel else 0
            scr.addnstr(y, 0, line.ljust(w - 1), w - 1, attr)
            if mark != " ":
                scr.addstr(y, 1, mark, attr | curses.color_pair(1))
            scr.addnstr(y, 9, proj, w - 10, attr | curses.color_pair(2))
        if DET and rows:
            cur = rows[hover] if hover is not None and hover < len(rows) else rows[sel]
            details(scr, cur, h - 1 - DET, w, DET)
        scr.addnstr(h - 1, 0, " ⏎/click open · ^N new · Esc close · F5 toggle" if sidebar else " Enter/click open · ● = open in grid · ^N new in dir · ^R rescan · Esc clear/detach · F1 here · F2 zoom",
                    w - 1, curses.color_pair(3))
        scr.refresh()

        try:
            k = scr.get_wch()
        except curses.error:  # timeout -> just refresh
            k = None
        if time.time() - last_scan > 10 or k == "\x12":  # periodic or Ctrl-R
            sessions, last_scan = load_sessions(), time.time()
        if k != curses.KEY_MOUSE:  # skip the tmux call on every mouse move
            live = open_panes()
        if k not in (None, curses.KEY_MOUSE):
            hover = None

        if k == curses.KEY_DOWN:
            sel += 1
        elif k == curses.KEY_UP:
            sel -= 1
        elif k == curses.KEY_NPAGE:
            sel += body
        elif k == curses.KEY_PPAGE:
            sel -= body
        elif k == curses.KEY_HOME:
            sel = 0
        elif k == curses.KEY_END:
            sel = len(rows) - 1
        elif k in ("\n", "\r", curses.KEY_ENTER) and rows:
            open_session(rows[sel])
        elif k == "\x0e":  # Ctrl-N: new session, folder prompt pre-filled from the highlighted one
            start = rows[sel].get("cwd") if rows else None
            path = ask_dir(scr, start if start and os.path.isdir(start) else str(HOME))
            if path:
                new_session(path)
        elif k in (curses.KEY_BACKSPACE, "\x7f", "\b"):
            query, sel = query[:-1], 0
        elif k == "\x15":  # Ctrl-U
            query, sel = "", 0
        elif k == "\x1b":
            if query:
                query, sel = "", 0
            elif sidebar:
                toggle_sidebar(tmux("display", "-p", "-t", os.environ["TMUX_PANE"], "#{window_id}"))
            else:
                tmux("detach-client")
        elif k == curses.KEY_MOUSE:
            try:
                _, mx, my, _, b = curses.getmouse()
            except curses.error:
                continue
            if b & curses.REPORT_MOUSE_POSITION and not b & (curses.BUTTON1_PRESSED | curses.BUTTON1_CLICKED):
                hover = top + my - 1 if 1 <= my <= body and top + my - 1 < len(rows) else None
                continue
            if b & curses.BUTTON4_PRESSED:
                sel -= 3
            elif b & WHEEL_DOWN:
                sel += 3
            elif b & (curses.BUTTON1_PRESSED | curses.BUTTON1_CLICKED) and 1 <= my <= body:
                idx = top + my - 1
                if idx < len(rows):
                    sel = idx
                    open_session(rows[idx])
        elif isinstance(k, str) and k.isprintable():
            query, sel = query + k, 0


def main():
    locale.setlocale(locale.LC_ALL, "")
    if "--notify" in sys.argv:
        return notify()
    if "--retile" in sys.argv:
        return retile(sys.argv[-1])
    if "--toggle-sidebar" in sys.argv:
        return toggle_sidebar(sys.argv[-1])
    if "--picker" in sys.argv:
        try:
            curses.wrapper(picker, "--sidebar" in sys.argv)
            sys.stdout.write("\033[?1003l")
        except KeyboardInterrupt:
            pass
        return
    env = {k: v for k, v in os.environ.items() if k != "TMUX"}
    base = ["tmux", "-L", SOCKET, "-f", str(CONF)]
    if subprocess.run(base + ["has-session", "-t", "ccm"], capture_output=True, env=env).returncode:
        me = f"{shlex.quote(sys.executable)} {shlex.quote(os.path.abspath(__file__))} --picker"
        subprocess.run(base + ["new-session", "-d", "-s", "ccm", "-n", "sessions", "-c", str(HOME),
                               f"while :; do {me}; sleep 0.3; done"], env=env, check=True)
    os.execvpe("tmux", base + ["attach", "-t", "ccm"], env)


if __name__ == "__main__":
    main()
